<odoo>
    <record id="crm_meeting_transcript_view_list" model="ir.ui.view">
        <field name="name">crm.meeting.transcript.list</field>
        <field name="model">crm.meeting.transcript</field>
        <field name="arch" type="xml">
            <list string="Meeting transcripts">
                <field name="meeting_date"/>
                <field name="name"/>
                <field name="lead_id"/>
                <field name="partner_ids" widget="many2many_tags"/>
                <field name="duration_minutes" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="source" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="crm_meeting_transcript_view_form" model="ir.ui.view">
        <field name="name">crm.meeting.transcript.form</field>
        <field name="model">crm.meeting.transcript</field>
        <field name="arch" type="xml">
            <form string="Meeting transcript">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Kick-off with the customer"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="lead_id"/>
                            <field name="partner_ids" widget="many2many_tags"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="meeting_date"/>
                            <field name="duration_minutes"/>
                            <field name="source"/>
                            <field name="external_ref"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary" name="summary">
                            <field name="summary"/>
                        </page>
                        <page string="Transcript" name="transcript">
                            <field name="transcript"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="crm_meeting_transcript_view_search" model="ir.ui.view">
        <field name="name">crm.meeting.transcript.search</field>
        <field name="model">crm.meeting.transcript</field>
        <field name="arch" type="xml">
            <search string="Meeting transcripts">
                <field name="name"/>
                <field name="lead_id"/>
                <field name="partner_ids"/>
                <field name="transcript"/>
                <filter string="Mine" name="mine" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Meeting date" name="meeting_date" date="meeting_date"/>
                <group>
                    <filter string="Opportunity" name="group_lead" context="{'group_by': 'lead_id'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="crm_meeting_transcript_action" model="ir.actions.act_window">
        <field name="name">Meeting transcripts</field>
        <field name="res_model">crm.meeting.transcript</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">File a meeting's transcript</p>
            <p>Keep what was said with the opportunity it belongs to.</p>
        </field>
    </record>

    <menuitem
        id="crm_meeting_transcript_menu"
        name="Meeting transcripts"
        parent="crm.crm_menu_sales"
        action="crm_meeting_transcript_action"
        sequence="20"/>
</odoo>
