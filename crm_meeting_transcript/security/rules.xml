<!-- A transcript is seen by whoever sees its opportunity, as the CRM's own
     rules decide that (crm_rule_personal_lead, crm_rule_all_lead); one
     without an opportunity by the person who filed it. -->
<odoo>
    <data noupdate="1">
        <record id="crm_meeting_transcript_rule_personal" model="ir.rule">
            <field name="name">Meeting transcripts: of my opportunities</field>
            <field name="model_id" ref="model_crm_meeting_transcript"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), '&amp;', ('lead_id', '!=', False), '|', ('lead_id.user_id', '=', user.id), ('lead_id.user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>
        <record id="crm_meeting_transcript_rule_all" model="ir.rule">
            <field name="name">Meeting transcripts: all</field>
            <field name="model_id" ref="model_crm_meeting_transcript"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        </record>
        <record id="crm_meeting_transcript_rule_company" model="ir.rule">
            <field name="name">Meeting transcripts: multi-company</field>
            <field name="model_id" ref="model_crm_meeting_transcript"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
