<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Override the Apps action to exclude enterprise modules -->
        <record id="base.open_module_tree" model="ir.actions.act_window">
            <field name="name">Apps</field>
            <field name="path">apps</field>
            <field name="res_model">ir.module.module</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('application', '=', True), '|', ('to_buy', '=', False), ('to_buy', '=', None)]</field>
            <field name="search_view_id" ref="base.view_module_filter"/>
            <field name="context">{'search_default_hide_enterprise': 1}</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_empty_folder">
                No module found!
              </p><p>
                You should try other search criteria.
              </p>
            </field>
        </record>

        <!-- Also add a filter in the search view to allow toggling enterprise modules -->
        <record id="view_module_filter_hide_enterprise" model="ir.ui.view">
            <field name="name">ir.module.module.search.hide.enterprise</field>
            <field name="model">ir.module.module</field>
            <field name="inherit_id" ref="base.view_module_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='extra']" position="after">
                    <filter name="hide_enterprise" string="Hide Enterprise" domain="['|', ('to_buy', '=', False), ('to_buy', '=', None)]" default="1"/>
                    <filter name="show_enterprise" string="Show Enterprise" domain="[('to_buy', '=', True)]"/>
                </xpath>
            </field>
        </record>

        <!-- Add enterprise grouping back to search view -->
        <record id="view_module_filter_enterprise_group" model="ir.ui.view">
            <field name="name">ir.module.module.search.enterprise.group</field>
            <field name="model">ir.module.module</field>
            <field name="inherit_id" ref="base.view_module_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='state']" position="after">
                    <filter string="Odoo Enterprise Module" name="enterprise" domain="[]" context="{'group_by':'to_buy'}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
